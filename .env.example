# Copy values into `dotnet user-secrets` (dev) or Render env vars (prod). Never commit real values.
# ASP.NET Core maps "__" to ":" in config keys.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=fivestack;Username=fivestack;Password=fivestack
# Neon (prod): when set, these win over ConnectionStrings__Default. `neon deploy` writes them to .env.local.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=
Authentication__Discord__ClientId=
Authentication__Discord__ClientSecret=
# Email links (confirm, reset password) start from this URL. Required outside Development.
App__PublicUrl=
# Resend (https://resend.com): required outside Development while Auth__RequireConfirmedEmail is true (the default).
Email__ResendApiKey=
Email__From=FiveStack <noreply@your-domain>
